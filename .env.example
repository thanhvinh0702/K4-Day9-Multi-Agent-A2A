# Copy this file to .env and replace the placeholder with your real key.
# Never commit .env or your API key.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional. Remove this line to use the default model, or enter any model name.
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
# Optional metadata; no size validation is performed.
OPENROUTER_PARAMETER_SIZE=unknown
LLM_ENABLED=true
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
